# Environment for running the backend locally (bazel run //backend:fast_app_dev_runner).
#
#   cp .env.example .env        # .env is git-ignored
#   set -a; source .env; set +a
#
# Apart from the Redis below, everything here is local or a placeholder: no
# other secret is needed to boot. The placeholders only have to be present;
# the clients behind them connect on first use, so the feature they serve
# fails when used, not at startup. Replace one with a real value only to work
# on that feature.
#
# The last section lists every optional variable, commented out. They are
# defined in backend/common/environment_constants.py.

# --- Real values ---------------------------------------------------------------

# Your own Neon database (or any Postgres). Not one another environment uses:
# `bazel run //tools:init_db` drops everything in it before creating the
# schema. The driver is asyncpg, so the scheme is postgresql+asyncpg and SSL is
# `ssl=require`; the `sslmode` and `channel_binding` parameters in the string
# Neon's console gives you are not accepted.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require

# The Upstash Redis the team hands out for local development. The client
# always connects over TLS and pings it at startup, so the app does not boot
# without it.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Google Application Default Credentials. Startup builds Google API clients,
# which need some credentials to exist. Run
# `gcloud auth application-default login` once, then:
#
# - If it saved them under ~/.config/gcloud, leave this unset; the clients
#   find them on their own.
# - Otherwise set this to the absolute path gcloud printed, with its leading
#   "/" (a relative path is resolved from the current directory). For example:
#     Credentials saved to file: [/tmp/tmp.ZBALaLhSHa/application_default_credentials.json]
#   becomes
#     GOOGLE_APPLICATION_CREDENTIALS=/tmp/tmp.ZBALaLhSHa/application_default_credentials.json
#   A path under /tmp can be cleared on restart: log in again and update this.
# - Without a Google login, point it at a placeholder file instead (see
#   "Google credentials" in the README):
#     GOOGLE_APPLICATION_CREDENTIALS=$HOME/.purrf-dev/adc.json
#
# Once set, it must name a file that exists; nothing else is looked at.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Required at startup, placeholders are fine ------------------------------

MENTORSHIP_CALENDAR_ID=placeholder
INTERVIEW_CALENDAR_ID=placeholder
# Publishing a notification fails (and is logged) against this topic.
NOTIFICATION_TOPIC=projects/placeholder/topics/placeholder

USER_EMAIL=placeholder@example.com
SERVICE_ACCOUNT_EMAIL=placeholder@example.com
ADMIN_EMAIL=placeholder@example.com

GERRIT_URL=http://placeholder
GERRIT_USER=placeholder
GERRIT_HTTP_PASS=placeholder

JIRA_SERVER=http://placeholder
JIRA_USER=placeholder
JIRA_PASSWORD=placeholder

# Do not put the company mailbox's real refresh token here: with it, local
# code sends real mail.
GMAIL_CLIENT_ID=placeholder
GMAIL_CLIENT_SECRET=placeholder
GMAIL_REFRESH_TOKEN=placeholder
GMAIL_SENDER_RECRUITING=placeholder@example.com
GMAIL_SENDER_NOTIFICATION=placeholder@example.com

# --- Optional: unset is fine -------------------------------------------------
#
# Each feature below stays off, or fails when used, until its variables hold
# real values. Set them only to work on that feature.

# Log level; INFO when unset.
# LOG_LEVEL=INFO

# LaunchDarkly. Unset runs offline: every flag returns its default.
# LAUNCHDARKLY_SDK_KEY=

# Sign-in of deployed environments: Cloudflare Access, and the Google identity
# tokens of service accounts. Not read locally, where fast_app_dev_runner signs
# everyone in as one super admin.
# CF_TEAM_DOMAIN=
# CF_AUD_TAG=
# GOOGLE_AUDIENCE=
# GOOGLE_SERVICE_ACCOUNT_SUBS=
# Service accounts allowed to call the notification push route and the
# matcher completion callback. Unset, those routes refuse every request.
# NOTIFICATION_PUSHER_SUBS=
# MATCHER_JOB_SUBS=

# Adding and verifying a sign-in email (Auth0 email OTP and account linking).
# AUTH0_TENANT_DOMAIN=
# AUTH0_PASSWORDLESS_CLIENT_ID=
# AUTH0_PASSWORDLESS_CLIENT_SECRET=
# AUTH0_M2M_CLIENT_ID=
# AUTH0_M2M_CLIENT_SECRET=
# AUTH0_M2M_AUDIENCE=
# EMAIL_OTP_STATE_JWT_SECRET=

# Inbox. A service without a sender address has no Inbox here.
# GMAIL_SENDER_MENTORSHIP=
# GMAIL_SENDER_INQUIRIES=
# Pub/Sub topic Gmail's watch publishes this mailbox's changes to.
# GMAIL_WATCH_TOPIC=
# Leave unset: when "true", this process claims new mail for its Inbox,
# competing with any deployed environment on the same mailbox.
# GMAIL_INBOX_ENABLED=

# Microsoft Graph (Teams chats and meetings). The Azure SDK reads the three
# AZURE_ variables itself.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# MICROSOFT_USER_LDAP=
# MICROSOFT_ADMIN_LDAP=

# Proxy for reaching Jira and Gerrit over the tailnet.
# TAILSCALE_PROXY=

# Mentorship notifications sent through Kit.
# KIT_API_KEY=

# Matching: the Cloud Run job a matching run starts
# (projects/<p>/locations/<l>/jobs/<j>).
# MATCHER_JOB_RESOURCE=

# Recruiting: the bucket resumes are stored in.
# RESUME_BUCKET=

# SCORM training: the bucket course packages live in, the host they are served
# from, the key signing their URLs, and every origin the app answers on (the
# content host must be none of them).
# TRAINING_BUCKET=
# TRAINING_CONTENT_HOST=
# TRAINING_TOKEN_SIGNING_KEY=
# APP_ORIGINS=
# Links of the mentor and mentee onboarding trainings.
# MENTORSHIP_MENTOR_ONBOARDING_LINK=
# MENTORSHIP_MENTEE_ONBOARDING_LINK=

# Read only by the Gerrit webhook registration script
# (backend/notification_management/register_gerrit_webhook.py), not by the
# backend.
# GERRIT_WEBHOOK_TARGET_URL=
# GERRIT_WEBHOOK_PROJECT=All-Projects
# GERRIT_WEBHOOK_REMOTE_NAME=gerrit-webhook
# GERRIT_WEBHOOK_EVENTS=
