{
  "_comment": [
    "Shared contract for submission-form question visibility. Loaded by both",
    "tests/backend_test/recruiting_test/form_visibility_test.py and",
    "tests/frontend_test/pages_test/recruiting/postings/questionVisibility.test.js.",
    "backend/recruiting/form_visibility.py deletes the answers to every question",
    "the renderer in frontend/src/pages/Recruiting/postings/questionVisibility.js",
    "leaves out, so the two must resolve identically. Defining the behaviour here",
    "once turns a divergence into a red test on both sides instead of two",
    "docstrings vouching for each other.",
    "Schemas are written camelCase, exactly as they are persisted in JSONB."
  ],
  "cases": [
    {
      "name": "a question with no rule is always shown",
      "questions": [{ "id": "q1" }, { "id": "q2" }],
      "answers": { "q1": "x" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": "x" }
    },
    {
      "name": "a rule matching a scalar answer shows its question",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Yes" } }
      ],
      "answers": { "q1": "Yes", "q2": "F-1 OPT" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": "Yes", "q2": "F-1 OPT" }
    },
    {
      "name": "a rule that stopped matching hides its question and drops its answer",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Yes" } }
      ],
      "answers": { "q1": "No", "q2": "F-1 OPT" },
      "visible": ["q1"],
      "pruned": { "q1": "No" }
    },
    {
      "name": "a rule matches membership in a list answer",
      "questions": [
        { "id": "q1", "type": "multi_choice" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Remote" } }
      ],
      "answers": { "q1": ["Remote", "Hybrid"], "q2": "kept" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": ["Remote", "Hybrid"], "q2": "kept" }
    },
    {
      "name": "a list answer without the target value hides the question",
      "questions": [
        { "id": "q1", "type": "multi_choice" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Remote" } }
      ],
      "answers": { "q1": ["On-site"], "q2": "dropped" },
      "visible": ["q1"],
      "pruned": { "q1": ["On-site"] }
    },
    {
      "name": "an unanswered gate hides everything behind it",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Yes" } }
      ],
      "answers": {},
      "visible": ["q1"],
      "pruned": {}
    },
    {
      "name": "a chain hides transitively, not one layer per pass",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Yes" } },
        { "id": "q3", "showWhen": { "questionId": "q2", "equals": "Yes" } },
        { "id": "q4", "showWhen": { "questionId": "q3", "equals": "Yes" } }
      ],
      "answers": { "q1": "No", "q2": "Yes", "q3": "Yes", "q4": "an essay" },
      "visible": ["q1"],
      "pruned": { "q1": "No" }
    },
    {
      "name": "a fully satisfied chain stays visible end to end",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Yes" } },
        { "id": "q3", "showWhen": { "questionId": "q2", "equals": "Yes" } }
      ],
      "answers": { "q1": "Yes", "q2": "Yes", "q3": "deep" },
      "visible": ["q1", "q2", "q3"],
      "pruned": { "q1": "Yes", "q2": "Yes", "q3": "deep" }
    },
    {
      "name": "a chain broken in the middle hides everything downstream",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Yes" } },
        { "id": "q3", "showWhen": { "questionId": "q2", "equals": "Yes" } }
      ],
      "answers": { "q1": "Yes", "q2": "No", "q3": "stale" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": "Yes", "q2": "No" }
    },
    {
      "name": "both branches gated on one hidden root disappear together",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1", "equals": "Yes" } },
        { "id": "q3", "showWhen": { "questionId": "q1", "equals": "Yes" } },
        { "id": "q4", "showWhen": { "questionId": "q2", "equals": "Yes" } }
      ],
      "answers": { "q1": "No", "q2": "Yes", "q3": "also", "q4": "deep" },
      "visible": ["q1"],
      "pruned": { "q1": "No" }
    },
    {
      "name": "a rule cycle shows nothing in the loop instead of recursing",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q3", "equals": "Yes" } },
        { "id": "q3", "showWhen": { "questionId": "q2", "equals": "Yes" } }
      ],
      "answers": { "q1": "x", "q2": "Yes", "q3": "Yes" },
      "visible": ["q1"],
      "pruned": { "q1": "x" }
    },
    {
      "name": "a rule pointing at a question that is not on the form hides it",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "gone", "equals": "Yes" } }
      ],
      "answers": { "q1": "x", "q2": "orphan" },
      "visible": ["q1"],
      "pruned": { "q1": "x" }
    },
    {
      "name": "an answer whose question left the form is dropped",
      "questions": [{ "id": "q1" }],
      "answers": { "q1": "kept", "q5": "WeChat" },
      "visible": ["q1"],
      "pruned": { "q1": "kept" }
    },
    {
      "name": "an option's follow-up keeps its answer only while that option is picked",
      "questions": [
        {
          "id": "q3",
          "type": "multi_choice",
          "options": ["Backend", "Frontend"]
        },
        {
          "id": "q4",
          "type": "short_text",
          "showWhen": { "questionId": "q3", "equals": "Frontend" }
        }
      ],
      "answers": { "q3": ["Backend"], "q4": "Infrastructure" },
      "visible": ["q3"],
      "pruned": { "q3": ["Backend"] }
    },
    {
      "name": "several options each keep their own follow-up answer",
      "questions": [
        {
          "id": "q3",
          "type": "multi_choice",
          "options": ["Backend", "Frontend"]
        },
        {
          "id": "q4",
          "type": "short_text",
          "showWhen": { "questionId": "q3", "equals": "Backend" }
        },
        {
          "id": "q5",
          "type": "short_text",
          "showWhen": { "questionId": "q3", "equals": "Frontend" }
        }
      ],
      "answers": {
        "q3": ["Backend", "Frontend"],
        "q4": "Infrastructure",
        "q5": "Design systems"
      },
      "visible": ["q3", "q4", "q5"],
      "pruned": {
        "q3": ["Backend", "Frontend"],
        "q4": "Infrastructure",
        "q5": "Design systems"
      }
    },
    {
      "name": "falsy answers are kept: presence decides, not truthiness",
      "questions": [{ "id": "q1" }, { "id": "q2" }],
      "answers": { "q1": "", "q2": [] },
      "visible": ["q1", "q2"],
      "pruned": { "q1": "", "q2": [] }
    },
    {
      "name": "a null recorded answer is kept, not read as unanswered",
      "questions": [{ "id": "q1" }, { "id": "q2" }],
      "answers": { "q1": null, "q2": "x" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": null, "q2": "x" }
    },
    {
      "name": "an empty rule states no condition, so its question shows",
      "questions": [{ "id": "q1" }, { "id": "q2", "showWhen": {} }],
      "answers": { "q1": "x", "q2": "kept" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": "x", "q2": "kept" }
    },
    {
      "name": "a rule naming no value to compare states no condition",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "questionId": "q1" } }
      ],
      "answers": { "q1": null, "q2": "kept" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": null, "q2": "kept" }
    },
    {
      "name": "a rule naming no gate to read states no condition",
      "questions": [
        { "id": "q1" },
        { "id": "q2", "showWhen": { "equals": "Yes" } }
      ],
      "answers": { "q1": "No", "q2": "kept" },
      "visible": ["q1", "q2"],
      "pruned": { "q1": "No", "q2": "kept" }
    },
    {
      "name": "a question with no id owns no answer key",
      "questions": [
        { "type": "short_text", "label": "orphan" },
        { "id": "q1" }
      ],
      "answers": { "q1": "x", "undefined": "stray" },
      "visible": [null, "q1"],
      "pruned": { "q1": "x" }
    },
    {
      "name": "a question id that names an Object prototype member owns no answer",
      "questions": [{ "id": "toString" }, { "id": "q1" }],
      "answers": { "q1": "x" },
      "visible": ["toString", "q1"],
      "pruned": { "q1": "x" }
    },
    {
      "name": "a form with no questions keeps no answers",
      "questions": [],
      "answers": { "q1": "x" },
      "visible": [],
      "pruned": {}
    },
    {
      "name": "a null questions list keeps no answers",
      "questions": null,
      "answers": { "q1": "x" },
      "visible": [],
      "pruned": {}
    }
  ]
}
